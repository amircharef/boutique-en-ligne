// Schéma Boutique en ligne — PostgreSQL

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  new
  confirmed
  shipped
  delivered
  cancelled
}

model ProductCategory {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  order    Int       @default(0)
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  price       Int // en DA
  images      String[]
  sizes       String[]
  stock       Int      @default(0)
  featured    Boolean  @default(false)
  order       Int      @default(0)

  category   ProductCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([featured])
}

model Order {
  id           String      @id @default(cuid())
  customerName String
  phone        String
  address      String
  city         String
  note         String?
  status       OrderStatus @default(new)
  items        OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  product   Product @relation(fields: [productId], references: [id])
  productId String

  size      String?
  quantity  Int    @default(1)
  unitPrice Int // prix en DA au moment de la commande

  @@index([orderId])
}
